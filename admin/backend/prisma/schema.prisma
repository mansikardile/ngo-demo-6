generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
}

enum StudentVerificationStatus {
  VERIFIED_COLLEGE      // Approved institutional domain
  PENDING_VERIFICATION  // Other .edu / .ac.in domain awaiting manual review
  GENERAL_STUDENT       // Personal email (gmail/yahoo/outlook)
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum ApplicationJourneyStatus {
  NOT_STARTED
  STARTED
  COMPLETED
}

enum ScholarshipApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
}

enum MentorshipStatus {
  PENDING
  MATCHED
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  REGISTERED
  STARTED
  COMPLETED
  ACCEPTED
  REJECTED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]  @relation("AdminEvents")

  @@map("admins")
}

model StudentUser {
  id                    String                    @id @default(cuid())
  fullName              String
  email                 String                    @unique
  passwordHash          String?
  phone                 String?
  collegeName           String?
  collegeDomain         String?
  yearOfStudy           String?
  branch                String?
  isProfileComplete     Boolean                   @default(false)
  isCollegeVerified     Boolean                   @default(false)
  verificationStatus    StudentVerificationStatus @default(GENERAL_STUDENT)
  authProvider          AuthProvider              @default(LOCAL)
  googleId              String?                   @unique
  profileImageUrl       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  sessionRegistrations  SessionRegistration[]
  scholarshipApplication ScholarshipApplication?
  mentorshipRequests    MentorshipRequest[]

  @@index([email])
  @@map("student_users")
}

model Event {
  id                   String                @id @default(cuid())
  code                 String                @unique
  title                String
  collegeName          String
  location             String?
  eventDate            DateTime
  description          String?
  isActive             Boolean               @default(true)
  createdById          String?
  createdBy            Admin?                @relation("AdminEvents", fields: [createdById], references: [id])
  leads                StudentLead[]
  sessionRegistrations SessionRegistration[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("events")
}

model SessionRegistration {
  id                String                   @id @default(cuid())
  trackingId        String                   @unique @default(cuid())
  studentId         String
  eventId           String
  status            RegistrationStatus       @default(REGISTERED)
  applicationStatus ApplicationJourneyStatus @default(NOT_STARTED)
  registeredAt      DateTime                 @default(now())
  attendedAt        DateTime?

  student           StudentUser              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event             Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([studentId, eventId])
  @@index([studentId])
  @@index([eventId])
  @@map("session_registrations")
}

model ScholarshipApplication {
  id                  String                       @id @default(cuid())
  studentId           String                       @unique
  student             StudentUser                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Step 1: Academic Background
  currentCgpaOrMarks  String?
  tenthPercentage     String?
  twelfthPercentage   String?
  diplomaPercentage   String?
  admissionCategory   String?
  
  // Step 2: Family & Socio-Economic Background
  annualFamilyIncome  String?
  primaryEarnerName   String?
  primaryEarnerJob    String?
  familyMembersCount  Int?
  hasSingleParent     Boolean                      @default(false)
  hasFirstGenLearner  Boolean                      @default(false)
  
  // Step 3: Documents Upload Links
  incomeCertUrl       String?
  collegeIdCardUrl    String?
  marksheetUrl        String?
  rationCardUrl       String?
  
  // Step 4: Statement of Purpose & Aspirations
  whyStemEssay        String?
  careerAspiration    String?
  needsLaptopGrant    Boolean                      @default(true)
  
  status              ScholarshipApplicationStatus @default(DRAFT)
  adminFeedback       String?
  submittedAt         DateTime?
  interviewScheduledAt DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@map("scholarship_applications")
}

model Mentor {
  id           String              @id @default(cuid())
  name         String
  company      String              // e.g. Google, Mastercard, Microsoft, IBM
  roleTitle    String              // e.g. Senior Staff Engineer, Engineering Director
  expertise    String              // e.g. Cloud & Distributed Systems, AI/ML, Cybersecurity
  experienceYrs Int                @default(5)
  bio          String
  avatarUrl    String?
  linkedinUrl  String?
  isAvailable  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  mentorshipRequests MentorshipRequest[]

  @@map("mentors")
}

model MentorshipRequest {
  id           String           @id @default(cuid())
  studentId    String
  mentorId     String
  goalsNotes   String?
  preferredDomain String?
  status       MentorshipStatus @default(PENDING)
  meetingLink  String?
  scheduledDate DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student      StudentUser      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor       Mentor           @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([mentorId])
  @@map("mentorship_requests")
}

model TechLab {
  id           String   @id @default(cuid())
  title        String
  category     String   // e.g. DSA & Coding, Cloud Computing, Fullstack, Resume Bootcamp
  instructor   String
  durationHrs  Int      @default(10)
  totalModules Int      @default(6)
  description  String
  level        String   @default("Beginner to Intermediate")
  bannerUrl    String?
  syllabus     String?
  isLive       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tech_labs")
}

model StudentLead {
  id              String     @id @default(cuid())
  trackingId      String     @unique @default(cuid())
  fullName        String
  email           String
  phone           String
  college         String
  yearOfStudy     String
  fieldOfStudy    String
  status          LeadStatus @default(REGISTERED)
  digitalConsent  Boolean    @default(true)
  signatureDataUrl String?   @db.Text
  syncedFromOffline Boolean   @default(false)
  personalizedUrl String?
  notes           String?
  eventId         String
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([email])
  @@index([eventId])
  @@map("student_leads")
}
